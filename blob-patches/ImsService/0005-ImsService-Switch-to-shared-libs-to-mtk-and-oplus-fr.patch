Subject: [PATCH 5/6] ImsService: Switch to shared libs to mtk and oplus
 frameworks

Signed-off-by: Saikrishna1504 <saikrishna26918@gmail.com>
---
 AndroidManifest.xml | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/AndroidManifest.xml b/AndroidManifest.xml
index db34243..a34d6c9 100644
--- a/AndroidManifest.xml
+++ b/AndroidManifest.xml
@@ -57,6 +57,15 @@
         <uses-library android:name="com.mediatek.wfo.legacy" android:required="false"/>
         <uses-library android:name="mediatek-ims-wwop-common" android:required="false"/>
         <uses-library android:name="mediatek-wfo-legacy" android:required="false"/>
+        <uses-library android:name="mediatek-common" android:required="true"/>
+        <uses-library android:name="mediatek-framework" android:required="true"/>
+        <uses-library android:name="mediatek-ims-base" android:required="true"/>
+        <uses-library android:name="mediatek-ims-common" android:required="true"/>
+        <uses-library android:name="mediatek-telephony-common" android:required="true"/>
+        <uses-library android:name="mediatek-telecom-common" android:required="true"/>
+        <uses-library android:name="mediatek-telephony-base" android:required="true"/>
+        <uses-library android:name="oplus-framework" android:required="true"/>
+        <uses-library android:name="oplus-framework-telephony" android:required="true"/>
         <service android:exported="true" android:name="com.mediatek.ims.MtkDynamicImsService" android:permission="android.permission.BIND_IMS_SERVICE">
             <meta-data android:name="android.telephony.ims.RCS_FEATURE" android:value="true"/>
             <meta-data android:name="android.telephony.ims.MMTEL_FEATURE" android:value="true"/>
